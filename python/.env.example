# Variables d'environnement du back Python (V2). Copier en `.env` (gitignoré) et renseigner.
# AUCUN secret réel ici : ce fichier est versionné. Voir docs/runbook-bot-discord.md.

# --- Récepteur & envoi Discord (OPP-117 / OPP-124 / OPP-125) ---
# Token du bot Discord (SECRET) — Developer Portal › Bot › Reset Token.
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID du salon où poster les cartes de revue (mode développeur › clic droit salon › Copier l'ID).
DISCORD_CHANNEL_ID=000000000000000000
# IDs Discord autorisés à valider (CSV). VIDE = personne (fail-closed).
# Clic droit sur l'utilisateur › Copier l'ID.
DISCORD_REVIEWER_IDS=000000000000000000,111111111111111111

# --- LLM local Ollama (OPP-073 / OPP-113) ---
# Hôte du serveur Ollama (cf. README « LLM local » ; sous Docker : http://host.docker.internal:11434).
# Laisser vide/commenté sous WSL : scripts/serve-api.sh auto-détecte la passerelle (OPP-153).
# OLLAMA_HOST=http://localhost:11434
# Modèle utilisé pour l'analyse d'offre et la rédaction de lettre.
OLLAMA_MODEL=ministral-3:3b
# Plafond de tokens générés par appel (num_predict) : plafond anti-emballement, pas une
# cible — l'appel s'arrête à l'EOS bien avant. Défaut 2048 : dimensionné sur la sortie la
# plus longue (la lettre, ~1000 tokens), pas sur le JSON d'intake, pour ne jamais tronquer
# une lettre légitime. Baisser pour borner la latence, au risque de tronquer une lettre.
OLLAMA_NUM_PREDICT=2048
# Timeout LLM généreux (secondes), partagé par le runner push, l'intake de profil ET
# l'intake d'offre (POST /offers). Défaut 300 : lettre et intake réel dépassent 60 s à froid.
OPPORTUNE_LLM_TIMEOUT=300

# --- Collecte RSS (OPP-122, connecteur actif, sans secret) ---
# Flux RSS/Atom d'alertes emploi à collecter, séparés par des virgules (ou passés en
# --feed au runner `python -m app.rss_runner`). Aucune authentification requise.
RSS_FEED_URLS=https://exemple.fr/offres.rss,https://autre.fr/flux.xml

# --- Collecte Adzuna (OPP-120, connecteur actif) ---
# Identifiants de l'application créée sur developer.adzuna.com (inscription gratuite,
# instantanée). Requis par le runner `python -m app.adzuna_runner`.
ADZUNA_APP_ID=xxxxxxxx
ADZUNA_APP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Collecte France Travail (OPP-120, connecteur dormant) ---
# L'API Offres d'emploi n'est plus en self-service : accès sur demande + contrat de licence.
# Connecteur prêt (`python -m app.france_travail_runner`) mais inactif tant que l'accès n'est
# pas accordé. Identifiants OAuth2 de l'application créée sur francetravail.io (SECRETS).
FRANCE_TRAVAIL_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FRANCE_TRAVAIL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Boucle push (OPP-128) ---
# Candidat ciblé par le runner push.
OPPORTUNE_CANDIDATE_ID=ma-recherche
# Provenance affichée des offres collées (optionnel).
OPPORTUNE_OFFER_SOURCE=collée

# --- Base SQLite ---
# Chemin de la base (défaut data/opportune.db ; :memory: pour les tests).
OPPORTUNE_DB_PATH=data/opportune.db
