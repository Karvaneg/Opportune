# Copier ce fichier en .env.local et renseigner les valeurs (.env.local est gitignoré).

# --- Accès Notion ---
# Token d'intégration Notion (secret) — https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ID de la base (database) Notion
NOTION_DATABASE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ID de la data source interrogée par le code (@notionhq/client v5 = data sources)
NOTION_DATA_SOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Ciblage des skills /start-ticket et /ship (mise à jour du statut du ticket) ---
# Propriété portant l'identifiant du ticket (ici la propriété title de la base)
NOTION_TICKET_ID_PROP=ID
# Propriété statut à mettre à jour
NOTION_STATUS_PROP=Statut
# Option marquant le ticket « en cours » — /start-ticket (nom exact de l'option Notion)
NOTION_DOING_OPTION=In Progress
# Option marquant le ticket « terminé » — /ship (nom exact de l'option Notion)
NOTION_DONE_OPTION=Done
