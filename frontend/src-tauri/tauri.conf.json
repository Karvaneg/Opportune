{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Opportune",
  "version": "1.0.0",
  "identifier": "com.opportune.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png"],
    "externalBin": ["binaries/opportune-api"]
  }
}
